# Copy to .env and fill in. Never commit .env.

# --- Frontier model ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-haiku-4-5-20251001
HARD_MODEL=claude-opus-5

# --- Workstation (RTX 5090) via Tailscale; see docs/workstation/ ---
VLLM_API_KEY=
VLLM_CHAT_URL=http://workstation:8000/v1
VLLM_EMBED_URL=http://workstation:8001/v1
VLLM_RERANK_URL=http://workstation:8002/v1
VLLM_CHAT_MODEL=qwen3-8b
VLLM_EMBED_MODEL=qwen3-embed
VLLM_RERANK_MODEL=bge-rerank

# --- Mac: LM Studio and the LiteLLM gateway ---
LMSTUDIO_URL=http://localhost:1234/v1
LITELLM_URL=http://localhost:4000

# --- Mac: local services (infra/mac/docker-compose.yml) ---
DATABASE_URL=postgresql://sprint:sprint@localhost:5433/sprint
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333
FALKORDB_URL=redis://localhost:6380

# --- Tracing (Day 5) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# --- Managed embeddings / rerank comparisons (Days 6-7) ---
VOYAGE_API_KEY=
COHERE_API_KEY=

# --- Synthetic bank ---
BANK_DB_PATH=data/bank.db
