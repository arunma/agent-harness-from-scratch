# Copy to .env on the workstation and fill in.
BIND_IP=100.x.y.z               # workstation Tailscale IP: run `tailscale ip -4`
VLLM_API_KEY=change-me-long-random-string   # generate: openssl rand -hex 32
HF_TOKEN=                        # only needed for gated models
HF_CACHE=/home/arun/.cache/huggingface   # point at your existing cache to reuse downloaded weights
CHAT_MODEL=Qwen/Qwen3-8B-FP8
VLLM_TAG=latest                  # replace with a pinned version once stable
